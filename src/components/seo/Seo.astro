---
import { SITE_URL } from '@content/config/site.mjs';
import { t, localePath, locales, type Locale } from '@/lib/i18n';
import { absolute, organizationLd, webPageLd } from '@/lib/seo';

interface Props {
  locale: Locale;
  /** Путь без языкового префикса, например "/procedure" */
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Array<Record<string, unknown>>;
  noindex?: boolean;
  /** Не добавлять суффикс бренда к title (для главной) */
  bare?: boolean;
}

const { locale, path, title, description, ogImage, jsonLd = [], noindex = false, bare = false } = Astro.props;
const dict = t(locale);
const fullTitle = bare ? title : `${title}${dict.meta.titleSuffix}`;
const canonical = absolute(localePath(locale, path));
const image = ogImage ?? absolute(`/media/og-image-${locale}-1200.jpg`);
const ld = [organizationLd(locale), webPageLd(locale, path, fullTitle, description), ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
{locales.map((l) => <link rel="alternate" hreflang={l === 'kk' ? 'kk-KZ' : 'ru-KZ'} href={absolute(localePath(l, path))} />)}
<link rel="alternate" hreflang="x-default" href={absolute(localePath('ru', path))} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Hydromed" />
<meta property="og:locale" content={locale === 'kk' ? 'kk_KZ' : 'ru_KZ'} />
<meta property="og:locale:alternate" content={locale === 'kk' ? 'ru_KZ' : 'kk_KZ'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="geo.region" content="KZ-75" />
<meta name="geo.placename" content={dict.meta.cityName} />
<link rel="sitemap" href={`${SITE_URL}/sitemap-index.xml`} />

{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
