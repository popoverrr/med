# ============================================================================
# Hydromed — .htaccess для Plesk (Apache / nginx+Apache). Кладётся в корень httpdocs.
# ============================================================================

Options -Indexes -MultiViews
AddDefaultCharset utf-8
ServerSignature Off

# --- MIME-типы (на случай старых конфигураций) -------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS + без www ---------------------------------------------------------
  # (если сайт будет на www — поменять местами, см. DEPLOY.md)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # --- Закрытые файлы ----------------------------------------------------------
  RewriteRule ^api/(config\.php|config\.example\.php|_bootstrap\.php|lib/|_data/) - [F,L]
  RewriteRule \.(map|log|jsonl|md|lock)$ - [F,L]
  RewriteRule (^|/)\.(git|env|ht) - [F,L]

  # --- Чистые URL: /procedure -> procedure.html, /kk -> kk/index.html ------------
  # Убираем .html из адреса (301), если кто-то зашёл по старой ссылке
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  # Убираем завершающий слэш (кроме реальных каталогов)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  # Внутренне отдаём .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
  # /kk -> /kk/index.html без редиректа
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html

# --- Сжатие ------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
  # Уже сжатые форматы не трогаем
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|woff2?|mp4|webm|pdf)$ no-gzip
</IfModule>

# --- Кэширование -------------------------------------------------------------
<IfModule mod_headers.c>
  # Хэшированные ассеты сборки (name.XXXXXXXX.js) — год, immutable; прочие js/css — сутки
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2|avif|webp|jpe?g|png|gif|svg|ico|mp4|webm|pdf)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  # HTML — всегда перепроверять
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # --- Security-заголовки ------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CSP: скрипты только свои + SHA-256 inline-загрузчиков островов Astro (подставляются при сборке,
  # scripts/postbuild-csp.mjs); inline-стили нужны Astro/GSAP; img/media blob: и data: — для canvas/WebGL
  # и placeholder-текстур; frame-src — карта 2GIS.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; frame-src https://widgets.2gis.com https://2gis.kz https://yandex.ru https://yandex.kz; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Файлы .map (source maps) не отдаём никогда
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
