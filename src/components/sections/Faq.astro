---
/** FAQ: аккордеон с плавным раскрытием через grid-template-rows (0fr → 1fr). */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { t, type Locale } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const d = dict.home.faq;
---

<section class="faq theme-light" data-bg="bone" id="faq" aria-labelledby="faq-title">
  <div class="container-x faq__inner">
    <div class="faq__head">
      <Eyebrow>{d.eyebrow}</Eyebrow>
      <h2 id="faq-title" class="t-d2" data-split="words">{d.title}</h2>
    </div>
    <div class="faq__list" data-reveal-group data-reveal-stagger="0.05">
      {d.items.map((item, i) => (
        <div class="faq__item" data-faq-item data-reveal>
          <h3 class="faq__q">
            <button type="button" class="faq__toggle" aria-expanded="false" aria-controls={`faq-panel-${i}`} id={`faq-btn-${i}`} data-faq-toggle data-cursor="button">
              <span class="faq__q-text">{item.q}</span>
              <span class="faq__icon" aria-hidden="true"><span></span><span></span></span>
            </button>
          </h3>
          <div class="faq__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`} data-faq-panel>
            <div class="faq__panel-inner"><p class="muted faq__a">{item.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { position: relative; padding-block: var(--section-y); }
  .faq__inner { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .faq__list { display: flex; flex-direction: column; border-top: 1px solid var(--c-line-on-light); }
  .faq__item { border-bottom: 1px solid var(--c-line-on-light); }
  .faq__q { font: inherit; letter-spacing: 0; }
  .faq__toggle { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 0; text-align: left; min-height: 44px; }
  .faq__q-text { font-family: var(--font-display); font-size: var(--fs-h4); font-weight: 400; letter-spacing: -0.01em; line-height: 1.3; transition: color var(--d-fast) var(--e-out); }
  .faq__toggle:hover .faq__q-text { color: var(--c-burgundy-700); }
  .faq__icon { position: relative; flex: none; width: 28px; height: 28px; border: 1px solid var(--c-line-on-light); border-radius: 50%; transition: border-color var(--d-fast) var(--e-out), transform var(--d-base) var(--e-out); }
  .faq__icon span { position: absolute; left: 50%; top: 50%; width: 10px; height: 1.2px; background: currentColor; transform: translate(-50%, -50%); transition: transform var(--d-base) var(--e-out); }
  .faq__icon span:last-child { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item.is-open .faq__icon { transform: rotate(45deg); border-color: var(--c-burgundy-600); }
  .faq__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--d-base) var(--e-out); }
  .faq__item.is-open .faq__panel { grid-template-rows: 1fr; }
  .faq__panel-inner { overflow: hidden; }
  .faq__a { max-width: 64ch; padding-bottom: 1.5rem; opacity: 0; transform: translateY(-6px); transition: opacity var(--d-base) var(--e-out), transform var(--d-base) var(--e-out); }
  .faq__item.is-open .faq__a { opacity: 1; transform: none; }
  @media (min-width: 1024px) { .faq__inner { grid-template-columns: 4fr 8fr; column-gap: 5rem; align-items: start; } .faq__head { position: sticky; top: 7rem; } }
</style>
