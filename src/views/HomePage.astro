---
/**
 * Главная — короткая посадочная (≈3 минуты чтения), mobile-first:
 * 1 hero (что это, для чего, кто, записаться) → 2 врач (видео, 20 лет · 1500+, документы) →
 * 3 с чем помогает (карусель → статьи) → 4 как проходит (20–45 мин, стерильность) → 5 вода →
 * 6 противопоказания (свёрнуты) → 7 цены → 8 FAQ (5) → 9 запись + контакты.
 * Сквозная WebGL-капля: hero → врач (в угол) → гаснет на «С чем помогает». На телефонах — только первые экраны.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SceneLayer from '@/components/sections/SceneLayer.astro';
import Hero from '@/components/landing/Hero.astro';
import Doctor from '@/components/landing/Doctor.astro';
import HelpCarousel from '@/components/landing/HelpCarousel.astro';
import How from '@/components/landing/How.astro';
import Water from '@/components/landing/Water.astro';
import Important from '@/components/landing/Important.astro';
import Prices from '@/components/sections/Prices.astro';
import Faq from '@/components/sections/Faq.astro';
import BookingSection from '@/components/sections/BookingSection.astro';
import StickyCta from '@/components/landing/StickyCta.astro';
import { t, type Locale } from '@/lib/i18n';
import { procedureLd, faqLd } from '@/lib/seo';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  path="/"
  title={dict.seo.home.title}
  description={dict.seo.home.description}
  page="home"
  headerTone="dark"
  bg="dark"
  bare
  jsonLd={[procedureLd(locale), faqLd(locale)]}
>
  <SceneLayer locale={locale} />
  <div class="scene-range" data-scene-range>
    <Hero locale={locale} />
    <Doctor locale={locale} />
    <div data-scene="fade"><HelpCarousel locale={locale} /></div>
  </div>
  <How locale={locale} />
  <Water locale={locale} />
  <Important locale={locale} />
  <Prices locale={locale} compact />
  <Faq locale={locale} limit={5} />
  <BookingSection locale={locale} withContacts />
  <StickyCta locale={locale} />
</BaseLayout>

<style>
  .scene-range { position: relative; }
</style>
