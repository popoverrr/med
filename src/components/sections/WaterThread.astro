---
/**
 * «Нить воды» (ТЗ §4.2.12): тонкая SVG-линия вдоль левого поля, сшивающая секции главной.
 * Прорисовывается по скроллу (dashoffset) и морфит из прямой в волну (собственная интерполяция путей).
 * Только десктоп; декоративная.
 */
---
<div class="thread" data-thread aria-hidden="true">
  <svg class="thread__svg" preserveAspectRatio="none" viewBox="0 0 40 1000">
    <defs>
      <linearGradient id="thread-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4fc3d6" stop-opacity="0.9" />
        <stop offset="0.45" stop-color="#8fd6e2" stop-opacity="0.9" />
        <stop offset="1" stop-color="#4fc3d6" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path class="thread__path" data-thread-path d="M20 0 L20 1000" fill="none" stroke="url(#thread-grad)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .thread { display: none; position: absolute; top: 0; bottom: 0; left: calc(var(--gutter) * 0.45); width: 40px; pointer-events: none; z-index: 0; }
  .thread__svg { width: 100%; height: 100%; overflow: visible; }
  @media (min-width: 1280px) { html.js:not(.rm) .thread { display: block; } }
</style>
