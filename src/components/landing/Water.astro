---
/** Вода — компактно: заголовок, два прибора, одна фраза. Подробности — на /water. */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Picture from '@/components/ui/Picture.astro';
import water from '@content/config/water.json';
import { t, localePath, type Locale } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const d = dict.landing.water;
---

<section class="wtr theme-light" data-bg="porcelain" id="water" aria-labelledby="water-title">
  <div class="container-x wtr__inner">
    <div class="wtr__text">
      <Eyebrow>{d.eyebrow}</Eyebrow>
      <h2 id="water-title" class="t-d2 wtr__title" data-split="words">{d.title}</h2>
      <p class="wtr__lead muted" data-reveal>{d.text}</p>
      <a class="wtr__more" href={localePath(locale, '/water')} data-reveal data-cursor="link">{dict.common.learnMore}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <ul class="wtr__stages" data-reveal-group data-reveal-stagger="0.15">
      {water.stages.map((s, i) => (
        <li class="wtr__stage" data-reveal>
          <Picture id={s.slot} locale={locale} sizes="(min-width: 1024px) 22vw, 44vw" />
          <p class="wtr__stage-label"><span class="t-caps wtr__stage-step">{d.stages[i]}</span><span class="wtr__stage-brand">{s.brand}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wtr { position: relative; padding-block: var(--section-y); }
  .wtr__inner { display: grid; grid-template-columns: 1fr; gap: 1.75rem; }
  .wtr__title { max-width: 14ch; }
  .wtr__lead { margin-top: 1rem; max-width: 44ch; }
  .wtr__more { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; min-height: 44px; color: var(--c-deep-700); font-weight: 500; }
  .wtr__stages { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
  .wtr__stage-label { display: flex; flex-direction: column; gap: 0.15rem; margin-top: 0.75rem; }
  .wtr__stage-step { color: var(--c-aqua-text); }
  .wtr__stage-brand { font-family: var(--font-display); font-size: var(--fs-h4); }
  @media (min-width: 1024px) { .wtr__inner { grid-template-columns: 5fr 7fr; column-gap: 5rem; align-items: center; } }
</style>
