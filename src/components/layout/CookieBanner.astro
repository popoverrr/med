---
/**
 * Cookie-баннер (ТЗ §8.3): отклонить / настроить / принять. Внешние скрипты (карта, аналитика)
 * не грузятся до согласия. Выбор хранится в localStorage `hm-consent` (технически необходимый).
 */
import { t, localePath, type Locale } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<div class="cookie" data-cookie hidden role="region" aria-label={dict.cookie.title}>
  <div class="cookie__card">
    <p class="cookie__title t-h4">{dict.cookie.title}</p>
    <p class="cookie__text t-small">
      {dict.cookie.text} <a href={localePath(locale, '/legal/privacy')} class="link-u">{dict.cookie.link}</a>.
    </p>

    <form class="cookie__settings" data-cookie-settings hidden>
      <label class="cookie__row">
        <input type="checkbox" checked disabled />
        <span><strong>{dict.cookie.necessary}</strong><br /><span class="t-caption">{dict.cookie.necessaryText}</span></span>
      </label>
      <label class="cookie__row">
        <input type="checkbox" name="analytics" />
        <span><strong>{dict.cookie.analytics}</strong><br /><span class="t-caption">{dict.cookie.analyticsText}</span></span>
      </label>
      <label class="cookie__row">
        <input type="checkbox" name="maps" />
        <span><strong>{dict.cookie.maps}</strong><br /><span class="t-caption">{dict.cookie.mapsText}</span></span>
      </label>
    </form>

    <div class="cookie__actions">
      <button type="button" class="btn btn-secondary" data-cookie-action="reject">{dict.cookie.reject}</button>
      <button type="button" class="btn btn-secondary" data-cookie-action="settings">{dict.cookie.settings}</button>
      <button type="button" class="btn btn-secondary" data-cookie-action="save" hidden>{dict.cookie.save}</button>
      <button type="button" class="btn btn-primary" data-cookie-action="accept">{dict.cookie.accept}</button>
    </div>
  </div>
</div>

<style>
  .cookie {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 0 var(--gutter) max(1rem, env(safe-area-inset-bottom));
    pointer-events: none;
  }
  .cookie__card {
    pointer-events: auto;
    max-width: 560px;
    margin-left: auto;
    padding: 1.25rem 1.4rem;
    border-radius: var(--r-card);
    background: var(--c-bone);
    color: var(--c-ink);
    box-shadow: var(--sh-modal);
    border: 1px solid rgba(53, 10, 22, 0.08);
    transform: translateY(24px);
    opacity: 0;
    transition: transform var(--d-base) var(--e-out), opacity var(--d-base) var(--e-out);
  }
  .cookie.is-visible .cookie__card { transform: none; opacity: 1; }
  .cookie__title { margin-bottom: 0.35rem; }
  .cookie__text { color: var(--c-text-muted-on-light); }
  .cookie__settings { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--c-line-on-light); }
  .cookie__row { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.9375rem; cursor: pointer; }
  .cookie__row input { margin-top: 0.3rem; width: 18px; height: 18px; accent-color: var(--c-burgundy-700); }
  .cookie__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .cookie__actions .btn { flex: 1 1 auto; font-size: 0.875rem; }
</style>
