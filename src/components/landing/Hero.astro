---
/**
 * Первый экран главной: что это (гидроколонотерапия в Алматы), для чего (комфортное очищение),
 * кто проводит (врач, 20 лет), как записаться — всё на одном экране телефона.
 * Заголовок — LCP-элемент, на мобильных виден сразу (data-split-lcp).
 */
import Button from '@/components/ui/Button.astro';
import contacts from '@content/config/contacts.json';
import { t, localePath, type Locale } from '@/lib/i18n';
import { real } from '@/lib/utils/placeholders';
import { telHref } from '@/lib/utils/format';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const d = dict.landing.hero;
const phone = real(contacts.phone);
const icons = [
  '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"/>',
  '<path d="M4 12l4 4 12-12"/><path d="M4 18h16"/>',
  '<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M4 10h16M9 5v14"/>',
  '<path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
];
---

<section class="hero theme-dark" data-bg="dark" data-scene="hero" id="hero" aria-labelledby="hero-title">
  <div class="container-x hero__inner">
    <p class="hero__eyebrow t-caps" data-reveal data-reveal-delay="0.1">{d.eyebrow}</p>
    <h1 id="hero-title" class="hero__title t-hero" data-split="words" data-split-lcp>{d.title}</h1>
    <p class="hero__subtitle" data-reveal data-reveal-delay="0.3">{d.subtitle}</p>
    <p class="hero__text t-lead" data-reveal data-reveal-delay="0.4">{d.text}</p>

    <div class="hero__cta" data-reveal data-reveal-delay="0.5">
      <Button onDark data-open-booking class="hero__btn">{d.ctaPrimary}</Button>
      {phone
        ? <a class="btn btn-secondary-on-dark hero__btn" href={telHref(phone)} data-cursor="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
            {d.ctaCall}
          </a>
        : <Button variant="secondary" onDark href={localePath(locale, '/contacts')} class="hero__btn">{d.ctaCall}</Button>}
    </div>

    <ul class="hero__facts" data-reveal-group data-reveal-stagger="0.08" aria-label={d.eyebrow}>
      {d.facts.map((f, i) => (
        <li class="hero__fact" data-reveal>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
          <span>{f}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="container-x hero__foot" data-reveal data-reveal-delay="0.8" data-reveal-start="top 100%">
    <a href={localePath(locale, '/legal/license')} class="hero__license t-caption" data-cursor="link">
      <span class="hero__license-dot" aria-hidden="true"></span>{dict.common.licenseLine}
    </a>
    <p class="hero__scroll t-caption" aria-hidden="true"><span class="hero__scroll-line"><span></span></span>{d.scroll}</p>
  </div>
</section>

<style>
  .hero { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 100svh; padding-top: 6.5rem; }
  .hero__inner, .hero__foot { max-width: none; }
  .hero__inner { padding-bottom: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .hero__eyebrow { margin-bottom: 1rem; color: var(--c-glow-text); }
  /* «Гидроколонотерапия» — 18 букв одним словом: на узких экранах размер от ширины, чтобы слово не резалось */
  .hero__title { color: var(--c-bone); margin-bottom: 0.9rem; max-width: 12ch; font-size: min(var(--fs-hero), 8.4vw); }
  .hero__subtitle {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.375rem, 1.1rem + 1.4vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--c-aqua-400);
    margin-bottom: 1rem;
    max-width: 24ch;
  }
  .hero__text { color: var(--c-text-muted-on-dark); max-width: 40ch; margin-bottom: 1.5rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.75rem; }
  .hero__btn { min-height: 3.25rem; font-size: 1rem; }
  .hero__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 1rem; max-width: 40rem; }
  .hero__fact { display: flex; align-items: center; gap: 0.6rem; color: var(--c-bone); font-size: var(--fs-small); line-height: 1.3; }
  .hero__fact svg { flex: none; color: var(--c-glow); }
  .hero__foot {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-block: 1.1rem clamp(1.25rem, 1rem + 1vw, 2rem);
    border-top: 1px solid var(--c-line-on-dark); color: var(--c-text-muted-on-dark);
  }
  .hero__license { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; letter-spacing: 0.02em; transition: color var(--d-fast) var(--e-out); }
  .hero__license:hover { color: var(--c-bone); }
  .hero__license-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-gold); }
  .hero__scroll { display: none; align-items: center; gap: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero__scroll-line { position: relative; width: 48px; height: 1px; background: var(--c-line-on-dark); overflow: hidden; }
  .hero__scroll-line span { position: absolute; inset: 0; background: var(--c-bone); transform-origin: left; animation: scrollhint 2.4s var(--e-inout) infinite; }
  @keyframes scrollhint { 0% { transform: scaleX(0); transform-origin: left; } 45% { transform: scaleX(1); transform-origin: left; } 55% { transform: scaleX(1); transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }
  @media (max-width: 479px) {
    .hero__cta { display: grid; grid-template-columns: 1fr 1fr; }
    .hero__facts { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (min-width: 768px) { .hero__scroll { display: inline-flex; } }
  @media (min-width: 1024px) {
    .hero { padding-top: 7rem; }
    .hero__title { max-width: 14ch; font-size: var(--fs-hero); }
    .hero__facts { grid-template-columns: repeat(4, auto); justify-content: start; gap: 1rem 2rem; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line span { animation: none; transform: none; } }
</style>
