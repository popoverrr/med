---
/**
 * Превью скана документа → lightbox с зумом и скачиванием PDF (ТЗ §8.5).
 * Файлы: public/documents/<id>-{preview,medium,full}.webp, <id>.pdf
 */
import type { Locale } from '@/lib/i18n';
import { withBase } from '@/lib/base';

interface Props {
  id: string;
  alt: string;
  caption: string;
  group?: string;
  locale: Locale;
  class?: string;
  /** Соотношение сторон превью (портрет для лицензии, ландшафт для сертификата) */
  aspect?: string;
  label?: string;
}
const { id, alt, caption, group = 'documents', class: className = '', aspect = '3 / 4', label } = Astro.props;
---

<button
  type="button"
  class:list={['doc', className]}
  data-lightbox
  data-lightbox-src={withBase(`/documents/${id}-full.webp`)}
  data-lightbox-pdf={withBase(`/documents/${id}.pdf`)}
  data-lightbox-caption={caption}
  data-lightbox-alt={alt}
  data-lightbox-group={group}
  aria-label={`${caption}${label ? ` — ${label}` : ''}`}
  data-cursor="button"
  style={`--doc-aspect: ${aspect}`}
>
  <span class="doc__frame">
    <img
      src={withBase(`/documents/${id}-preview.webp`)}
      srcset={`${withBase(`/documents/${id}-preview.webp`)} 480w, ${withBase(`/documents/${id}-medium.webp`)} 1200w`}
      sizes="(min-width: 1024px) 24vw, 60vw"
      alt={alt}
      loading="lazy"
      decoding="async"
      width="480"
      height={aspect === '3 / 4' ? 640 : 331}
    />
  </span>
  {label && <span class="doc__label t-caption">{label}
    <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13l10-10M6 3h7v7" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
  </span>}
</button>

<style>
  .doc { display: block; width: 100%; text-align: left; }
  .doc__frame {
    display: block;
    aspect-ratio: var(--doc-aspect);
    overflow: hidden;
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--sh-card);
    border: 1px solid rgba(7, 49, 59, 0.08);
    transition: transform var(--d-base) var(--e-out), box-shadow var(--d-base) var(--e-out);
  }
  .doc__frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .doc:hover .doc__frame { transform: translateY(-4px); box-shadow: var(--sh-card-hover); }
  .doc__label { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.75rem; color: var(--c-text-muted-on-light); }
  :global(.theme-dark) .doc__label { color: var(--c-text-muted-on-dark); }
</style>
