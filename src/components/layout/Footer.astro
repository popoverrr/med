---
import Logo from '@/components/ui/Logo.astro';
import company from '@content/config/company.json';
import contacts from '@content/config/contacts.json';
import { t, localePath, type Locale } from '@/lib/i18n';
import { real } from '@/lib/utils/placeholders';
import { telHref } from '@/lib/utils/format';
import Placeholder from '@/components/ui/Placeholder.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();

const nav = [
  { href: '/procedure', label: dict.nav.procedure },
  { href: '/water', label: dict.nav.water },
  { href: '/prices', label: dict.nav.prices },
  { href: '/about', label: dict.nav.about },
  { href: '/contacts', label: dict.nav.contacts },
  { href: '/booking', label: dict.nav.book },
];
const legal = [
  { href: '/legal/privacy', label: dict.pages.legalIndex.items.privacy },
  { href: '/legal/consent', label: dict.pages.legalIndex.items.consent },
  { href: '/legal/offer', label: dict.pages.legalIndex.items.offer },
  { href: '/legal/patient-rights', label: dict.pages.legalIndex.items.patientRights },
  { href: '/legal/license', label: dict.pages.legalIndex.items.license },
];
const phone = real(contacts.phone);
const email = real(contacts.email);
const hours = real(contacts.hours[locale]);
---

<footer class="site-footer theme-dark" data-bg="ink" id="footer">
  <div class="container-x">
    <div class="site-footer__disclaimer" role="note">
      <span class="site-footer__age" aria-label={dict.common.ageLabel}>{dict.common.age}</span>
      <p>{dict.common.disclaimer}</p>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={localePath(locale, '/')} aria-label={`Hydromed — ${dict.nav.home}`}><Logo /></a>
        <p class="t-small muted-dark">{dict.footer.about}</p>
        <p class="t-small muted-dark">{dict.footer.madeNote}</p>
      </div>

      <div>
        <h2 class="site-footer__title t-caps">{dict.footer.navTitle}</h2>
        <ul class="site-footer__links">
          {nav.map((i) => <li><a href={localePath(locale, i.href)}>{i.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__title t-caps">{dict.footer.legalTitle}</h2>
        <ul class="site-footer__links">
          {legal.map((i) => <li><a href={localePath(locale, i.href)}>{i.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="site-footer__title t-caps">{dict.footer.contactsTitle}</h2>
        <address class="site-footer__address t-small">
          <p>{company.address.full[locale]}</p>
          <p>{phone ? <a href={telHref(phone)}>{real(contacts.phoneDisplay) ?? phone}</a> : <Placeholder value={contacts.phone} />}</p>
          <p>{email ? <a href={`mailto:${email}`}>{email}</a> : <Placeholder value={contacts.email} />}</p>
          <p>{hours ?? <Placeholder value={contacts.hours[locale]} />}</p>
        </address>
      </div>
    </div>

    <div class="site-footer__legal t-caption">
      <p><strong>{dict.footer.requisitesTitle}:</strong> {company.legalName[locale]}, {dict.home.license.fields.bin} {company.bin}. {company.address.full[locale]}.</p>
      <p><strong>{dict.footer.licenseTitle}:</strong> {dict.footer.licenseText} <a href={localePath(locale, '/legal/license')} class="link-u">{dict.footer.licenseLink}</a>.</p>
      <p>{dict.footer.offerNote}</p>
      <p>© {year} {company.legalNameShort[locale]}. {dict.footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: var(--z-content);
    background: var(--c-ink);
    color: var(--c-text-on-dark);
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
  }
  .site-footer__disclaimer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    border: 1px solid rgba(251, 253, 253, 0.22);
    border-radius: var(--r-control);
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 400;
    color: var(--c-bone);
  }
  .site-footer__age {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--c-glow);
    border-radius: 50%;
    font-family: var(--font-text);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--c-glow-text);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-bottom: 1px solid var(--c-line-on-dark);
  }
  .site-footer__brand { display: flex; flex-direction: column; gap: 1rem; max-width: 34ch; }
  .site-footer__title { margin-bottom: 1rem; color: var(--c-text-muted-on-dark); }
  .site-footer__links { display: flex; flex-direction: column; gap: 0.55rem; }
  .site-footer__links a { display: inline-block; min-height: 28px; font-size: 0.9375rem; opacity: 0.9; transition: opacity var(--d-fast) var(--e-out), color var(--d-fast) var(--e-out); }
  .site-footer__links a:hover { opacity: 1; color: var(--c-glow); }
  .site-footer__address { font-style: normal; display: flex; flex-direction: column; gap: 0.5rem; color: var(--c-text-muted-on-dark); }
  .site-footer__address a { color: var(--c-bone); }
  .site-footer__legal { display: flex; flex-direction: column; gap: 0.6rem; padding-top: 1.75rem; color: var(--c-text-muted-on-dark); max-width: 110ch; }
  .site-footer__legal strong { color: var(--c-bone); font-weight: 500; }
  @media (min-width: 720px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr 1fr; } .site-footer__brand { grid-column: 1 / -1; } }
  @media (min-width: 1024px) { .site-footer__grid { grid-template-columns: 1.6fr 1fr 1.2fr 1.3fr; } .site-footer__brand { grid-column: auto; } }
</style>
