---
/** Контакты: адрес, часы, телефон, мессенджеры, карта (загружается после согласия на cookie «Карта»). */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import company from '@content/config/company.json';
import contacts from '@content/config/contacts.json';
import { t, type Locale } from '@/lib/i18n';
import { real } from '@/lib/utils/placeholders';
import { telHref, waHref, tgHref } from '@/lib/utils/format';

interface Props { locale: Locale; heading?: 'h1' | 'h2'; title?: string }
const { locale, heading = 'h2', title } = Astro.props;
const dict = t(locale);
const d = dict.home.contacts;
const phone = real(contacts.phone);
const wa = real(contacts.whatsapp);
const tg = real(contacts.telegram);
const email = real(contacts.email);
const hours = real(contacts.hours[locale]);
const mapSrc = real(contacts.map.embedUrl);
const mapLink = real(contacts.map.linkUrl);
const Heading = heading;
---

<section class="contacts theme-light" data-bg="porcelain" id="contacts" aria-labelledby="contacts-title">
  <div class="container-x contacts__inner">
    <div class="contacts__text">
      <Eyebrow>{d.eyebrow}</Eyebrow>
      <Heading id="contacts-title" class="t-d2 contacts__title" data-split="words">{title ?? d.title}</Heading>
      <dl class="contacts__list" data-reveal-group data-reveal-stagger="0.08">
        <div class="contacts__row" data-reveal>
          <dt class="t-caps muted">{d.addressLabel}</dt>
          <dd><address class="contacts__addr">{company.address.full[locale]}</address></dd>
        </div>
        <div class="contacts__row" data-reveal>
          <dt class="t-caps muted">{d.hoursLabel}</dt>
          <dd>{hours ?? <Placeholder value={contacts.hours[locale]} />}</dd>
        </div>
        <div class="contacts__row" data-reveal>
          <dt class="t-caps muted">{d.phoneLabel}</dt>
          <dd class="contacts__phone">{phone ? <a href={telHref(phone)} class="link-u">{real(contacts.phoneDisplay) ?? phone}</a> : <Placeholder value={contacts.phone} />}</dd>
        </div>
        <div class="contacts__row" data-reveal>
          <dt class="t-caps muted">{d.messengersLabel}</dt>
          <dd class="contacts__msgs">
            {wa ? <a class="btn btn-secondary" href={waHref(wa)} target="_blank" rel="noopener">WhatsApp</a> : <span>WhatsApp: <Placeholder value={contacts.whatsapp} /></span>}
            {tg ? <a class="btn btn-secondary" href={tgHref(tg)} target="_blank" rel="noopener">Telegram</a> : <span>Telegram: <Placeholder value={contacts.telegram} /></span>}
          </dd>
        </div>
        <div class="contacts__row" data-reveal>
          <dt class="t-caps muted">{d.emailLabel}</dt>
          <dd>{email ? <a href={`mailto:${email}`} class="link-u">{email}</a> : <Placeholder value={contacts.email} />}</dd>
        </div>
      </dl>
    </div>

    <div class="contacts__map map" data-map data-map-src={mapSrc ?? ''} data-map-title={d.mapTitle} data-reveal="clip">
      <div class="map__placeholder" data-map-placeholder>
        <div class="map__grid" aria-hidden="true"></div>
        <div class="map__pin" aria-hidden="true"><span></span></div>
        <div class="map__consent">
          <p class="t-small">{d.mapConsent}</p>
          {mapSrc ? <button type="button" class="btn btn-primary" data-map-load>{d.mapLoad}</button> : <p class="t-caption"><Placeholder value={contacts.map.embedUrl} /></p>}
          {mapLink ? <a class="btn btn-ghost" href={mapLink} target="_blank" rel="noopener noreferrer">{d.mapOpen}</a> : <span class="t-caption muted">2GIS: <Placeholder value={contacts.map.linkUrl} /></span>}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .contacts { position: relative; padding-block: var(--section-y); }
  .contacts__inner { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  .contacts__title { margin-bottom: 2rem; max-width: 14ch; }
  .contacts__list { display: flex; flex-direction: column; }
  .contacts__row { display: grid; grid-template-columns: 1fr; gap: 0.5rem; padding: 1.1rem 0; border-top: 1px solid var(--c-line-on-light); }
  .contacts__addr { font-style: normal; max-width: 36ch; }
  .contacts__phone { font-family: var(--font-display); font-size: var(--fs-h4); }
  .contacts__msgs { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .map { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-media); overflow: hidden; background: #ece4e0; box-shadow: var(--sh-card); }
  .map__placeholder { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: 1.25rem; }
  .map__grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(53,10,22,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(53,10,22,.06) 1px, transparent 1px); background-size: 48px 48px; }
  .map__pin { position: absolute; left: 50%; top: 42%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--c-burgundy-700); box-shadow: 0 0 0 8px rgba(107, 23, 48, 0.12); }
  .map__pin span { position: absolute; inset: -18px; border-radius: 50%; border: 1px solid rgba(107, 23, 48, 0.35); animation: mappulse 2.4s var(--e-out) infinite; }
  @keyframes mappulse { 0% { transform: scale(0.4); opacity: 1; } 100% { transform: scale(1.4); opacity: 0; } }
  .map__consent { position: relative; display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; padding: 1.25rem; border-radius: var(--r-card); background: rgba(255, 252, 250, 0.9); backdrop-filter: blur(8px); max-width: 40ch; }
  .map__frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  @media (min-width: 640px) { .contacts__row { grid-template-columns: 10rem 1fr; gap: 1.5rem; } }
  @media (min-width: 1024px) { .contacts__inner { grid-template-columns: 5fr 7fr; column-gap: 5rem; align-items: start; } .map { aspect-ratio: 16 / 11; } }
  @media (prefers-reduced-motion: reduce) { .map__pin span { animation: none; } }
</style>
