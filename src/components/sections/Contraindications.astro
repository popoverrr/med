---
/** Противопоказания — честный блок на тёмном фоне (юридически обязателен, повышает доверие). */
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { t, type Locale } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const d = dict.home.contra;
---

<section class="contra theme-dark bg-dark-solid" data-bg="dark" id="contraindications" aria-labelledby="contra-title">
  <div class="container-x contra__inner">
    <div class="contra__head">
      <Eyebrow>{d.eyebrow}</Eyebrow>
      <h2 id="contra-title" class="t-d2 contra__title" data-split="words">{d.title}</h2>
      <p class="t-lead contra__intro" data-reveal>{d.intro}</p>
      <p class="contra__disclaimer" data-reveal>
        <span class="contra__age" aria-label={dict.common.ageLabel}>{dict.common.age}</span>
        {dict.common.disclaimer}
      </p>
    </div>
    <div class="contra__groups">
      {d.groups.map((g) => (
        <div class="contra__group" data-reveal-group data-reveal-stagger="0.06">
          <h3 class="t-caps contra__group-title" data-reveal>{g.title}</h3>
          <ul class="contra__list">
            {g.items.map((item) => (
              <li class="contra__item" data-reveal>
                <span class="contra__marker" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="contra__note t-small" data-reveal>{d.note}</p>
    </div>
  </div>
</section>

<style>
  .contra { position: relative; padding-block: var(--section-y); }
  .contra__inner { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  .contra__title { color: var(--c-bone); margin-bottom: 1.25rem; }
  .contra__intro { color: var(--c-text-muted-on-dark); max-width: 42ch; margin-bottom: 2rem; }
  .contra__disclaimer { display: flex; align-items: center; gap: 0.9rem; font-family: var(--font-display); font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem); color: var(--c-bone); padding: 1rem 1.25rem; border: 1px solid rgba(255, 252, 250, 0.22); border-radius: var(--r-control); max-width: 44ch; }
  .contra__age { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1.5px solid var(--c-wine-glow); border-radius: 50%; font-family: var(--font-text); font-size: 0.75rem; font-weight: 600; color: var(--c-wine-text); }
  .contra__groups { display: flex; flex-direction: column; gap: 2.5rem; }
  .contra__group-title { color: var(--c-wine-text); margin-bottom: 1rem; }
  .contra__list { display: flex; flex-direction: column; }
  .contra__item { display: flex; gap: 1rem; padding: 0.85rem 0; border-top: 1px solid var(--c-line-on-dark); color: var(--c-bone); }
  .contra__marker { flex: none; width: 6px; height: 6px; margin-top: 0.65em; border-radius: 50%; background: var(--c-wine-glow); }
  .contra__note { color: var(--c-text-muted-on-dark); max-width: 60ch; padding-top: 1.25rem; border-top: 1px solid var(--c-line-on-dark); }
  @media (min-width: 1024px) { .contra__inner { grid-template-columns: 5fr 7fr; column-gap: 5rem; align-items: start; } .contra__head { position: sticky; top: 7rem; } }
</style>
